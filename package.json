{
  "name": "crykit",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "node --experimental-strip-types --test scripts/wiki-sprites.test.mjs scripts/game-assets.test.mjs scripts/native-artwork.test.mjs scripts/mod-catalogs.test.mjs scripts/bundle-mod.test.mjs scripts/bundle-mod-library.test.mjs scripts/game-version.test.mjs scripts/update-game-data.test.mjs scripts/calculations.test.mjs scripts/update-entity-reference.test.mjs scripts/check-e2e-contracts.test.mjs scripts/integration-verification.test.mjs && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "corrections:review": "node scripts/review-corrections.mjs",
    "catalog:update": "node scripts/update-wiki-catalog.mjs",
    "sprites:update": "node scripts/update-wiki-sprites.mjs",
    "sprites:check": "node scripts/update-wiki-sprites.mjs --check",
    "class-trees:update": "node scripts/update-class-tree-identities.mjs",
    "class-trees:check": "node scripts/update-class-tree-identities.mjs --check",
    "game-identities:update": "node scripts/update-game-identities.mjs",
    "game-identities:check": "node scripts/update-game-identities.mjs --check",
    "game-data:update": "node --experimental-strip-types scripts/update-game-data.mjs",
    "game-data:check": "node --experimental-strip-types scripts/update-game-data.mjs --check",
    "entity-reference:update": "node scripts/update-entity-reference.mjs",
    "entity-reference:check": "node scripts/update-entity-reference.mjs --check",
    "game-assets:update": "node --experimental-strip-types scripts/update-game-assets.mjs",
    "game-assets:check": "node --experimental-strip-types scripts/update-game-assets.mjs --check",
    "mods:update": "node scripts/update-mod-catalogs.mjs",
    "mods:check": "node scripts/update-mod-catalogs.mjs --check",
    "mods:library:bundle": "node scripts/bundle-mod-library.mjs",
    "mods:library:check": "node scripts/bundle-mod-library.mjs --check",
    "check:privacy": "node scripts/privacy-check.mjs",
    "sources:audit": "node scripts/audit-sources.mjs",
    "sources:check": "node scripts/audit-sources.mjs --check",
    "check": "npm run check:e2e-contracts && npm run typecheck && npm test && npm run class-trees:check && npm run calculations:check && npm run game-identities:check && npm run game-assets:check && npm run game-data:check && npm run entity-reference:check && npm run sprites:check && npm run mods:check && npm run mods:library:check && npm run certainty:check && npm run sources:check && npm run check:privacy && npm run build",
    "check:e2e-contracts": "node scripts/check-e2e-contracts.mjs",
    "verify": "node scripts/verify-integration.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "deploy:dry-run": "npm run check:assets && wrangler deploy --dry-run",
    "deploy": "npm run check:assets && wrangler deploy",
    "check:assets": "node scripts/check-assets.mjs",
    "calculations:export": "node scripts/export-calculations.mjs",
    "calculations:update": "node scripts/update-native-stats.mjs",
    "calculations:check": "node scripts/update-native-stats.mjs --check",
    "certainty:audit": "node scripts/audit-certainty.mjs",
    "certainty:check": "node scripts/audit-certainty.mjs --check",
    "mods:bundle": "node scripts/bundle-mod.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "dexie": "4.4.6",
    "fflate": "0.8.3",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^28.0.0",
    "sharp": "^0.35.4",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.137.0"
  },
  "overrides": {
    "undici@<7.29.1": "7.29.1"
  }
}

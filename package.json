{
  "name": "crykit",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && npm run build:assets",
    "build:assets": "vite build",
    "build:preview": "CRYKIT_PREVIEW=1 npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run test:scripts && npm run test:vitest",
    "test:scripts": "node --experimental-strip-types --test scripts/capture-ui.test.mjs scripts/wiki-sprites.test.mjs scripts/game-assets.test.mjs scripts/native-artwork.test.mjs scripts/mod-artwork.test.mjs scripts/bundle-mod.test.mjs scripts/bundle-mod-library.test.mjs scripts/game-version.test.mjs scripts/update-game-data.test.mjs scripts/calculations.test.mjs scripts/update-entity-reference.test.mjs scripts/world-acquisition.test.mjs scripts/world-map.test.mjs scripts/check-e2e-contracts.test.mjs scripts/integration-verification.test.mjs scripts/offline-plugin.test.mjs scripts/source-audit-evidence.test.mjs",
    "test:vitest": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:dom": "vitest run --project dom",
    "test:persistence": "vitest run --project persistence",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:all-devices": "playwright test --config=playwright.all-devices.config.ts",
    "screenshots": "node scripts/capture-ui.mjs",
    "catalog:update": "node scripts/update-wiki-catalog.mjs",
    "sprites:update": "node scripts/update-wiki-sprites.mjs",
    "sprites:check": "node scripts/update-wiki-sprites.mjs --check",
    "class-trees:update": "node scripts/update-class-tree-identities.mjs",
    "class-trees:check": "node scripts/update-class-tree-identities.mjs --check",
    "game-identities:update": "node scripts/update-game-identities.mjs",
    "game-identities:check": "node scripts/update-game-identities.mjs --check",
    "game-data:update": "node --experimental-strip-types scripts/update-game-data.mjs",
    "game-data:check": "node --experimental-strip-types scripts/update-game-data.mjs --check",
    "entity-reference:update": "node scripts/update-entity-reference.mjs",
    "native-reference-links:check": "node scripts/check-native-reference-links.mjs --check",
    "entity-reference:check": "node scripts/update-entity-reference.mjs --check",
    "game-assets:update": "node --experimental-strip-types scripts/update-game-assets.mjs",
    "game-assets:check": "node --experimental-strip-types scripts/update-game-assets.mjs --check",
    "mods:artwork:update": "node --experimental-strip-types scripts/update-mod-artwork.mjs",
    "mods:artwork:check": "node --experimental-strip-types scripts/update-mod-artwork.mjs --check",
    "mods:library:bundle": "node scripts/bundle-mod-library.mjs",
    "mods:library:check": "node scripts/bundle-mod-library.mjs --check && node scripts/generate-mod-index.mjs --check",
    "mods:index:update": "node scripts/generate-mod-index.mjs",
    "mods:index:check": "node scripts/generate-mod-index.mjs --check",
    "check:privacy": "node scripts/privacy-check.mjs",
    "sources:audit": "node scripts/audit-sources.mjs",
    "sources:check": "node scripts/audit-sources.mjs --check",
    "check": "npm run check:deterministic && npm run build:assets",
    "check:deterministic": "npm run check:deterministic:base && npm run test:vitest",
    "check:deterministic:base": "npm run check:e2e-contracts && npm run typecheck && npm run test:scripts && npm run class-trees:check && npm run calculations:check && npm run game-identities:check && npm run game-assets:check && npm run game-data:check && npm run entity-reference:check && npm run native-reference-links:check && npm run world-acquisition:check && npm run world-map:check && npm run sprites:check && npm run mods:artwork:check && npm run mods:library:check && npm run certainty:check && npm run sources:check && npm run check:privacy",
    "check:e2e-contracts": "node scripts/check-e2e-contracts.mjs",
    "verify": "node scripts/verify-integration.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "deploy:dry-run": "npm run check:assets && wrangler deploy --dry-run",
    "deploy": "npm run check:assets && wrangler deploy",
    "deploy:preview:dry-run": "npm run build:preview && npm run check:assets && wrangler deploy --config wrangler.preview.jsonc --dry-run",
    "deploy:preview": "npm run build:preview && npm run check:assets && wrangler deploy --config wrangler.preview.jsonc",
    "check:assets": "node scripts/check-assets.mjs",
    "calculations:export": "node scripts/export-calculations.mjs",
    "calculations:update": "node scripts/update-native-stats.mjs && node scripts/update-combat-calculations.mjs",
    "calculations:check": "node scripts/update-native-stats.mjs --check && node scripts/update-combat-calculations.mjs --check && node scripts/render-calculation-reference.mjs --check",
    "calculations:reference": "node scripts/render-calculation-reference.mjs",
    "certainty:audit": "node scripts/audit-certainty.mjs",
    "certainty:check": "node scripts/audit-certainty.mjs --check",
    "mods:bundle": "node scripts/bundle-mod.mjs",
    "world-acquisition:update": "node --experimental-strip-types scripts/update-world-acquisition.mjs",
    "world-acquisition:check": "node --experimental-strip-types scripts/update-world-acquisition.mjs --check",
    "world-map:update": "node --experimental-strip-types scripts/update-world-map.mjs",
    "world-map:check": "node --experimental-strip-types scripts/update-world-map.mjs --check"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "dexie": "4.4.6",
    "fflate": "0.8.3",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^28.0.0",
    "sharp": "^0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.137.0"
  },
  "overrides": {
    "sharp": "$sharp",
    "undici@<7.29.1": "7.29.1"
  }
}

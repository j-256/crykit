{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crykit-accounts-email-example",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "secrets": { "required": ["EMAIL_STATE_SECRET"] },
  "vars": {
    "ACCOUNTS_ACTIVE": "false",
    "SIGNUP_ACTIVE": "false",
    "EMAIL_SENDING_ACTIVE": "false",
    "EMAIL_HEADROOM": "unknown",
    "EMAIL_FROM": "sender@example.com",
    "SERVICE_ORIGIN": "https://example.org"
  },
  "send_email": [{ "name": "NATIVE_EMAIL", "allowed_sender_addresses": ["sender@example.com"] }]
}

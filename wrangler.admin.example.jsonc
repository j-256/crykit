{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crykit-admin-example",
  "main": "worker/index.ts",
  "alias": { "@serenity-kit/opaque": "./.account-tests/opaque-runtime.js" },
  "build": { "command": "node scripts/build-account-tests.mjs --prepare-opaque" },
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "vars": {
    "ACCOUNTS_ACTIVE": "false",
    "SIGNUP_ACTIVE": "false",
    "SERVICE_ORIGIN": "https://example.org",
    "ADMIN_ACCESS_CONFIG": "{\"version\":1,\"issuer\":\"https://example.cloudflareaccess.com\",\"jwksUrl\":\"https://example.cloudflareaccess.com/cdn-cgi/access/certs\",\"adminAudience\":\"replace-ordinary-application-audience\",\"confirmationAudience\":\"replace-confirmation-application-audience\",\"confirmationEnabled\":false}"
  }
}
